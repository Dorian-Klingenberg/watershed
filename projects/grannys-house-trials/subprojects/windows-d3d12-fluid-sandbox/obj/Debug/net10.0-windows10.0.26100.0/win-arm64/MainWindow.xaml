<Window
    x:Class="WindowsD3D12FluidSandbox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="D3D12 Fluid Sandbox">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Padding="16" Spacing="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <TextBlock Text="Fluent Fluid Lab" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Direct3D 12 · Cellular" Opacity="0.75" />

            <Button x:ConnectionId='3' x:Name="RunButton" Content="Run"                         HorizontalAlignment="Stretch" />
            <Button x:ConnectionId='4' x:Name="StepButton" Content="Step"                          HorizontalAlignment="Stretch" />
            <Button x:ConnectionId='5' x:Name="PourButton" Content="Pour 12 in"                          HorizontalAlignment="Stretch" />
            <Button x:ConnectionId='6' x:Name="ResetButton" Content="Reset"                           HorizontalAlignment="Stretch" />

            <NumberBox x:ConnectionId='7' x:Name="PourDepthBox"
                       Header="Pour depth"
                       Minimum="1"
                       Maximum="72"
                       SmallChange="1"
                       LargeChange="12"
                       Value="12"
                       SpinButtonPlacementMode="Inline" />

            <TextBlock x:ConnectionId='8' x:Name="StatusText" Text="Initializing D3D12…" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Column="1" Margin="12" BorderThickness="1" CornerRadius="8"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <SwapChainPanel x:ConnectionId='2' x:Name="FluidSurface" />
        </Border>
    </Grid>
</Window>

