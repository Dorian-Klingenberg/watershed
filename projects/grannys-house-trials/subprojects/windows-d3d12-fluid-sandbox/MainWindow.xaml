<Window
    x:Class="WindowsD3D12FluidSandbox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="D3D12 Fluid Sandbox">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="296" MinWidth="296" MaxWidth="296" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Padding="16,14,16,16" Spacing="10">
                <TextBlock Text="Fluent Fluid Lab" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Direct3D 12 · Cellular" Opacity="0.75" />

                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="44" />
                    </Grid.RowDefinitions>
                    <Button x:Name="RunButton"
                            Grid.Row="0"
                            Grid.Column="0"
                            Content="Run"
                            MinHeight="44"
                            HorizontalAlignment="Stretch"
                            Click="RunButton_Click" />
                    <Button x:Name="StepButton"
                            Grid.Row="0"
                            Grid.Column="1"
                            Content="Step"
                            MinHeight="44"
                            HorizontalAlignment="Stretch"
                            Click="StepButton_Click" />
                    <Button x:Name="PourButton"
                            Grid.Row="1"
                            Grid.Column="0"
                            Content="Pour"
                            MinHeight="44"
                            HorizontalAlignment="Stretch"
                            Click="PourButton_Click" />
                    <Button x:Name="ResetButton"
                            Grid.Row="1"
                            Grid.Column="1"
                            Content="Reset"
                            MinHeight="44"
                            HorizontalAlignment="Stretch"
                            Click="ResetButton_Click" />
                </Grid>

                <ComboBox x:Name="BatchSizeBox"
                          Header="Ticks / display"
                          HorizontalAlignment="Stretch"
                          MinHeight="44"
                          SelectionChanged="BatchSizeBox_SelectionChanged">
                    <ComboBoxItem Content="1" Tag="1" IsSelected="True" />
                    <ComboBoxItem Content="2" Tag="2" />
                    <ComboBoxItem Content="4" Tag="4" />
                    <ComboBoxItem Content="8" Tag="8" />
                </ComboBox>

                <ToggleSwitch x:Name="CpuReferenceToggle"
                              Header="CPU reference"
                              OnContent="On"
                              OffContent="Off"
                              Toggled="CpuReferenceToggle_Toggled" />

                <NumberBox x:Name="PourDepthBox"
                           Header="Pour depth"
                           Minimum="1"
                           Maximum="72"
                           SmallChange="1"
                           LargeChange="12"
                           Value="12"
                           SpinButtonPlacementMode="Inline" />

                <NumberBox x:Name="MaxFlowBox"
                           Header="Max flow (in/tick)"
                           Minimum="0.01"
                           Maximum="12"
                           SmallChange="0.01"
                           LargeChange="1"
                           Value="2"
                           ValueChanged="FlowSettings_ValueChanged"
                           SpinButtonPlacementMode="Inline" />

                <NumberBox x:Name="SettleRateBox"
                           Header="Settle rate"
                           Minimum="0.01"
                           Maximum="1"
                           SmallChange="0.01"
                           LargeChange="0.1"
                           Value="0.5"
                           ValueChanged="FlowSettings_ValueChanged"
                           SpinButtonPlacementMode="Inline" />

                <ComboBox x:Name="ViewModeBox"
                          Header="Field view"
                          HorizontalAlignment="Stretch"
                          MinHeight="44"
                          SelectionChanged="ViewModeBox_SelectionChanged">
                    <ComboBoxItem Content="Top-down" Tag="0" IsSelected="True" />
                    <ComboBoxItem Content="Projected column" Tag="1" />
                </ComboBox>

                <ComboBox x:Name="TerrainToolBox"
                          Header="Terrain tool"
                          HorizontalAlignment="Stretch"
                          MinHeight="44"
                          SelectionChanged="TerrainToolBox_SelectionChanged">
                    <ComboBoxItem Content="Raise" Tag="raise" IsSelected="True" />
                    <ComboBoxItem Content="Carve" Tag="carve" />
                    <ComboBoxItem Content="Select" Tag="select" />
                </ComboBox>

                <Slider x:Name="ZoomSlider"
                        Header="Zoom"
                        Minimum="1"
                        Maximum="4"
                        SmallChange="0.1"
                        LargeChange="0.5"
                        StepFrequency="0.1"
                        Value="1"
                        ValueChanged="ViewSlider_ValueChanged" />

                <Slider x:Name="PanXSlider"
                        Header="Horizontal position"
                        Minimum="0"
                        Maximum="192"
                        SmallChange="1"
                        LargeChange="12"
                        StepFrequency="1"
                        Value="96"
                        ValueChanged="ViewSlider_ValueChanged" />

                <Slider x:Name="PanYSlider"
                        Header="Vertical position"
                        Minimum="0"
                        Maximum="128"
                        SmallChange="1"
                        LargeChange="12"
                        StepFrequency="1"
                        Value="64"
                        ValueChanged="ViewSlider_ValueChanged" />

                <Slider x:Name="YawSlider"
                        Header="Orbit yaw"
                        Minimum="0"
                        Maximum="360"
                        SmallChange="1"
                        LargeChange="15"
                        StepFrequency="1"
                        Value="0"
                        ValueChanged="ViewSlider_ValueChanged" />

                <Slider x:Name="ElevationSlider"
                        Header="Orbit elevation"
                        Minimum="15"
                        Maximum="80"
                        SmallChange="1"
                        LargeChange="10"
                        StepFrequency="1"
                        Value="80"
                        ValueChanged="ViewSlider_ValueChanged" />

                <Button x:Name="ResetViewButton"
                        Content="Reset view"
                        MinHeight="44"
                        HorizontalAlignment="Stretch"
                        Click="ResetViewButton_Click" />

                <TextBlock Text="Middle-drag: orbit · Right-drag: pan · Wheel: zoom"
                           Opacity="0.75"
                           TextWrapping="Wrap" />

                <Border Padding="12"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Native status" FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectionStatusText"
                                   Text="Select a cell in the field."
                                   TextWrapping="Wrap"
                                   LineHeight="22" />
                        <TextBlock x:Name="StatusText"
                                   Text="Initializing D3D12…"
                                   TextWrapping="Wrap"
                                   LineHeight="22" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Margin="12" BorderThickness="1" CornerRadius="8"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <SwapChainPanel x:Name="FluidSurface"
                            PointerPressed="FluidSurface_PointerPressed"
                            PointerMoved="FluidSurface_PointerMoved"
                            PointerReleased="FluidSurface_PointerReleased"
                            PointerCanceled="FluidSurface_PointerCanceled"
                            PointerCaptureLost="FluidSurface_PointerCaptureLost"
                            PointerWheelChanged="FluidSurface_PointerWheelChanged"
                            RightTapped="FluidSurface_RightTapped" />
        </Border>
    </Grid>
</Window>
